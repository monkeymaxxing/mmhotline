package app

// signInLinkUnavailableBody is the body of the page that says a sign-in link
// was already used or has expired.
templ signInLinkUnavailableBody() {
	<section class="panel">
		<div class="panel-body">
			<p>This sign-in link was already used or has expired.</p>
			<p>Ask someone with SSH access to the server for a new sign-in link.</p>
			<details class="fold">
				<summary>Create a new sign-in link</summary>
				<p>On the server, run <code>sudo mmhotline people create-sign-in-link --sign-in-email-address ADDRESS</code>, using your sign-in email address. Follow the command's SSH forwarding instructions, then open the new link.</p>
			</details>
			<a href="/dashboard">Try the dashboard again</a>
		</div>
	</section>
}
