package app

// triageAgentAtWorkPanel is the dashboard's panel for the triage agent. It
// shows the latest step only, cut short, and no Stop: every step and Stop are
// on the session's page.
templ triageAgentAtWorkPanel(frame pageFrame, agent TriageAgentAtWork) {
	<section id="triage-agent-at-work" data-live class="panel" aria-labelledby="triage-agent-heading">
		<div class="panel-head">
			<h2 id="triage-agent-heading">Triage agent</h2>
			if agent.Session != nil {
				<span class="tag work">{ agent.Phase }</span>
			} else {
				<span class="tag">Idle</span>
			}
		</div>
		<div class="panel-body">
			if session := agent.Session; session != nil {
				<p>Working on <a href={ "/triage-sessions/" + session.SessionID }>{ session.About }</a></p>
				<p class="faint small">
					if session.Phase != "working" {
						Since { frame.Clock(agent.SessionStartedAt) }. { session.PhaseText }
					} else {
						Since { frame.Clock(agent.SessionStartedAt) }.
					}
				</p>
				if step := agent.LatestStep; step != nil {
					<p class="faint small">{ countText(agent.Steps, "step", "steps") } so far. The latest, at { frame.Clock(step.OccurredAt) }, a { step.Kind }:</p>
					<pre class="step">{ step.Text }</pre>
				} else {
					<p class="faint small">No steps yet.</p>
				}
			} else {
				<p>Not working on any alert now.</p>
				if agent.LastSessionID != "" {
					<p class="faint small"><a href={ "/triage-sessions/" + agent.LastSessionID }>The last triage session</a> ended at { frame.Clock(agent.LastSessionEndedAt) }.</p>
				}
			}
		</div>
	</section>
}

// triageSessionHeading is the session page's heading: breadcrumbs, then the
// title, which can wrap after a slash or an underscore.
templ triageSessionHeading(title string) {
	<div>
		<p class="crumbs"><a href="/dashboard">Dashboard</a> / Triage session</p>
		<h1>@withBreaksAfterSeparators(title)</h1>
	</div>
}

// triageSessionBody is the session's own page. Lists stack on a phone;
// reports stay readable while commands and past runs stay folded.
templ triageSessionBody(frame pageFrame, page TriageSessionPage, csrf string) {
	<div class="stack triage-session">
		if page.TriageSession != nil {
			@triageSessionLiveView(frame, *page.TriageSession, csrf)
		}
		<section id="triage-session-reports" data-live class="panel">
			<div class="panel-head"><h2>Reports from the triage agent</h2></div>
			if len(page.Reports) > 0 {
				<ul class="items">
					for _, report := range page.Reports {
						<li>
							<div class="what">
								<div class="row">
									<h3>{ report.RunTitle }</h3>
									<span class={ "tag", templ.KV("sos", report.Severity == "sos"), templ.KV("warn", report.Severity == "warn") }>{ severityLabel(report.Severity) }</span><span class="faint small">{ frame.Clock(report.SentAt) }</span>
								</div>
								<pre>{ report.Text }</pre>
							</div>
						</li>
					}
				</ul>
				<p class="panel-foot">Each report was sent to people as an alert at the severity shown.</p>
			} else {
				<div class="panel-body"><p class="muted">No reports yet.</p></div>
			}
		</section>
		<section id="triage-session-alerts" data-live class="panel">
			<div class="panel-head"><h2>Alerts in this session</h2></div>
			<ul class="items">
				for _, alert := range page.Alerts {
					<li>
						<div class="what">
							<a class="title" href={ "/alerts/" + alert.ID }>@withBreaksAfterSeparators(alert.Title)</a><span class="faint small">Received { frame.Clock(alert.ReceivedAt) }</span>@triageSessionAlertIncident(alert)
						</div>
						<span class={ "tag", templ.KV("sos", alert.Severity == "sos"), templ.KV("warn", alert.Severity == "warn") }>{ severityLabel(alert.Severity) }</span>
					</li>
				}
				if len(page.Alerts) == 0 {
					<li>No alerts in this session.</li>
				}
			</ul>
		</section>
		<details class="more">
			<summary>Runs</summary>
			<div id="triage-session-runs" data-live class="body">
				<ul class="items">
					for _, run := range page.Runs {
						<li>
							<div class="what">
								<h3>{ run.Title }: { run.StateLabel }</h3>
								<p class="small faint">
									if !run.EndedAt.IsZero() {
										Started { frame.Clock(run.StartedAt) } · Ended { frame.Clock(run.EndedAt) } · { countText(run.Steps, "step", "steps") }
									} else {
										Started { frame.Clock(run.StartedAt) } · { countText(run.Steps, "step", "steps") }
									}
								</p>
								if run.FailureReason != "" {
									<p class="form-error">{ run.FailureReason }</p>
								}
							</div>
						</li>
					}
					if len(page.Runs) == 0 {
						<li>No run yet.</li>
					}
				</ul>
			</div>
		</details>
	</div>
}

// triageSessionAlertIncident says which SOS incident an alert of the session
// belongs to, or that a warning wakes nobody.
templ triageSessionAlertIncident(alert TriageSessionPageAlert) {
	if alert.IncidentID != "" {
		<p class="small"><a href={ "/incidents/" + alert.IncidentID }>{ alert.IncidentTitle }</a> · { incidentStatusLabel(alert.IncidentStatus) }</p>
	} else {
		<p class="small faint">No SOS incident: a warning wakes nobody.</p>
	}
}

// triageSessionLiveView is the live view on the session's own page. The
// incident page shows the session its own way (incidentTriageAgentPanel).
templ triageSessionLiveView(frame pageFrame, session TriageSessionLiveView, csrf string) {
	<section id="triage-agent" data-live class="panel">
		<div class="panel-head">
			<h2>Triage agent</h2>
			if session.Stoppable() {
				<span class="tag work">
					if session.Phase == "working" {
						Working
					} else {
						Waiting
					}
				</span>
			} else if session.Ended.IsZero() {
				<span class="tag work">
					if session.Phase == "stopping" {
						Stopping
					} else {
						Handing over
					}
				</span>
			} else {
				<span class="tag">Ended</span>
			}
		</div>
		<div class="panel-body">
			if session.Ended.IsZero() {
				<p><strong>{ session.PhaseText }</strong></p>
			}
			<p class="faint small">Started { frame.Clock(session.Started) }, { frame.RelativeTime(session.Started) }.</p>
			if session.TakenOverName != "" {
				<p>{ session.TakenOverName } pressed Stop at { frame.Clock(session.TakenOverAt) }.</p>
			}
			if !session.Ended.IsZero() {
				<p class="muted small">Ended { frame.Clock(session.Ended) }. { session.PageEndReason() }</p>
			}
			if session.Stoppable() {
				<form method="post" action={ "/triage-sessions/" + session.SessionID + "/stop" }>
					<input type="hidden" name="csrf" value={ csrf }/><button class="btn">{ session.StopButton() }</button>
				</form>
				<p class="small muted">Stop takes the session over from the triage agent after the current step and a hand-over report. An SOS waiting for the agent wakes the person on call at once.</p>
			}
			if run := session.Run; run != nil {
				<p>{ run.Title }: <strong>{ run.StateLabel }</strong> <span class="faint small">
					if !run.Ended.IsZero() {
						· Started { frame.Clock(run.Started) } · Ended { frame.Clock(run.Ended) }
					} else {
						· Started { frame.Clock(run.Started) }
					}
				</span></p>
				if run.FailureReason != "" {
					<p class="form-error" role="alert">{ run.FailureReason }</p>
				}
				if run.WaitingForSystemsRepository != "" {
					<p>{ run.WaitingForSystemsRepository }</p>
				}
				<details class="fold">
					<summary>Run steps</summary>
					if run.EarlierSteps > 0 {
						<p class="faint small">{ run.EarlierSteps } earlier steps are not shown.</p>
					}
					<ol class="triage-steps">
						for _, step := range run.Steps {
							<li>
								<p class="faint small">{ frame.Clock(step.OccurredAt) } · { step.PageKind() }</p>
								<pre>{ step.Text }</pre>
							</li>
						}
						if len(run.Steps) == 0 {
							<li>No steps yet.</li>
						}
					</ol>
				</details>
			} else {
				<p class="faint small">No run yet.</p>
			}
			<details class="fold">
				<summary>Session details</summary>
				<p class="small muted">A triage session groups the warning and SOS alerts that arrive while the agent works on a problem. The session ends when all its SOS incidents are resolved, no playbook run waits or runs, and no alert arrived for 30 minutes, or after a person stops the agent.</p>
				<p class="small faint">Session ID: <code>{ session.SessionID }</code></p>
			</details>
		</div>
	</section>
}
