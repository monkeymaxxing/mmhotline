package app

import "strconv"

// The SOS incident page. Its live sections, which refresh.js replaces when
// they change: incident-tags and incident-opened in the heading,
// incident-state (the decide box), incident-steps, triage-agent,
// incident-approvals, incident-audit ("What happened"), the bodies of the
// folded triage-agent-steps and incident-deliveries, and incident-people.
// The note field belongs to the form incident-action, which both Claim and
// Resolve submit, so one note reaches either without JavaScript.

// incidentHeading is the incident page's heading: breadcrumbs, tags, title,
// and the meta lines.
templ incidentHeading(frame pageFrame, page incidentPage) {
	<div class="incident-head">
		<p class="crumbs"><a href="/dashboard">Dashboard</a> / <a href="/alerts">Alerts</a> / SOS incident</p>
		<div id="incident-tags" data-live class="tags">
			if page.Incident.Status == "open" {
				<span class="tag sos">SOS</span><span class="tag nodot">Not claimed</span>
			} else if page.Incident.Status == "claimed" {
				<span class="tag sos">SOS</span><span class="tag work">Claimed</span>
			} else if page.Incident.Status == "resolved" {
				<span class="tag">SOS</span><span class="tag">Resolved</span>
			} else {
				<span class="tag sos">SOS</span><span class="tag">Resolved</span>
			}
		</div>
		<h1>{ page.Incident.Title }</h1>
		<p id="incident-opened" data-live class="meta faint">Opened { frame.Clock(page.Incident.CreatedAt) }, { frame.RelativeTime(page.Incident.CreatedAt) } · sent by { page.SentBy }</p>
		if page.ApprovalRequestID != "" {
			<p class="meta">MMHotline raised this SOS to wake the person on call: a playbook run waits for the team's approval. <a href={ "/approvals/" + page.ApprovalRequestID }>Open the approval request</a></p>
		}
	</div>
}

// colonAndText writes ": " and text after the element before it, or nothing
// for no text.
templ colonAndText(text string) {
	if text != "" {
		{ ": " + text }
	}
}

// incidentBody is the incident page below its heading.
templ incidentBody(frame pageFrame, page incidentPage) {
	<section
		id="incident-state"
		data-live
		class={ "decide", templ.KV("work", page.Incident.Status == "claimed"), templ.KV("done", page.Incident.Status == "resolved") }
		if page.Incident.Status == "resolved" {
			aria-label="How the incident ended"
		} else {
			aria-label="What you can do now"
		}
	>
		<div class="say"><strong>{ page.Say }</strong>@incidentCountdownBox(page.Countdown)
			if page.ResolvedNote != "" {
				<p class="muted">{ page.ResolvedNote }</p>
			}
			if page.Incident.Status != "resolved" {
				<form id="incident-action" method="post" action={ "/incidents/" + page.Incident.ID + "/claim" }>
					<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="revision" value={ strconv.FormatInt(page.Incident.Revision, 10) }/>
				</form>
				<label class="field">Note for the team (optional)<input name="note" form="incident-action" maxlength={ strconv.Itoa(page.MaximumNoteCharacters) } autocomplete="off"/></label>
				<p class="faint small">Claim and Resolve each keep your note in the incident history. The triage agent reads your note when the agent next looks into the incident.</p>
			}
		</div>
		if page.Incident.Status != "resolved" {
			<div class="do">
				if !page.ClaimedByYou {
					<button form="incident-action" class={ "btn block", templ.KV("primary big", page.Incident.Status == "open") }>
						if page.Incident.Status == "claimed" {
							Take over: I'm handling the incident
						} else {
							Claim: I'm handling the incident
						}
					</button>
				}
				<div class="row incident-do-row">
					<button form="incident-action" formaction={ "/incidents/" + page.Incident.ID + "/resolve" } class={ "btn", templ.KV("primary big", page.ClaimedByYou) }>Resolve</button>
					<details class="incident-more">
						<summary class={ "btn block", templ.KV("big", page.ClaimedByYou) }>More</summary>
						<div class="body">
							<form method="post" action={ "/incidents/" + page.Incident.ID + "/escalate" }>
								<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="revision" value={ strconv.FormatInt(page.Incident.Revision, 10) }/><label class="field">Escalate to someone else<select name="target" required><option value="">Choose a person</option>
										for _, option := range page.Escalate {
											<option
												value={ option.ID }
												if !option.UnavailableUntil.IsZero() {
													disabled
												}
											>{ escalateOptionText(frame, option, page.ReaderID) }</option>
										}
									</select></label><button class="btn block">Wake this person now</button>
								<p class="faint small">
									if page.Incident.Status == "claimed" {
										MMHotline wakes the selected person at once and waits for the selected person to claim the incident. The current claim ends.
									} else {
										MMHotline wakes the selected person at once and waits for the selected person to claim the incident.
									}
								</p>
							</form>
							if page.StatusPageCanPost {
								<a class="btn block" href="#status-page">
									if page.StatusPageNoticeID != 0 {
										Status page notice { page.StatusPageNoticeID }
									} else {
										Post to the status page
									}
								</a>
							}
						</div>
					</details>
				</div>
				<p class="faint small">
					if page.Incident.Status == "open" {
						Claiming an incident tells the team you are handling the incident and stops MMHotline waking anyone else.
					} else if page.ClaimedByYou {
						Resolve when the problem is over.
					} else {
						Taking over tells the team you are handling the incident now.
					}
				</p>
			</div>
		}
	</section>
	<ol id="incident-steps" data-live class="steps incident-steps" aria-label="Where this incident is">
		for _, step := range page.Steps {
			<li
				if step.State != "" {
					class={ step.State }
				}
			>
				if step.When != "" {
					{ step.Label }<span class="when">{ step.When }</span>
				} else {
					{ step.Label }
				}
			</li>
		}
	</ol>
	<div class="cols">
		<div class="col-main">
			if page.TriageSession != nil {
				@incidentTriageAgentPanel(frame, page)
			}
			@incidentApprovalsPanel(frame, page)
			<section id="incident-audit" data-live class="panel">
				<div class="panel-head">
					<h2>What happened</h2>
					<span class="faint small">Oldest first</span>
				</div>
				<div class="panel-body">
					<ol class="timeline">
						for _, event := range page.History {
							<li
								if event.Tone != "" {
									class={ event.Tone }
								}
							>
								<time>
									if !event.At.IsZero() {
										{ frame.Clock(event.At) }
									}
								</time><span class="dot"></span>
								<div>{ event.Text }@incidentEventReached(event.Reached)@incidentEventAgain(frame, event)@incidentEventNote(event.Note)@incidentEventAlert(event)</div>
							</li>
						}
					</ol>
				</div>
			</section>
			<div class="folds">
				<details class="more">
					<summary>The alert's full message</summary>
					<div class="body">
						if page.Incident.Message != "" {
							<pre>{ page.Incident.Message }</pre>
						} else {
							<p class="faint">The alert came without a message.</p>
						}
					</div>
				</details>
				if session := page.TriageSession; session != nil {
					<details class="more">
						<summary>The triage agent's steps</summary>
						<div id="triage-agent-steps" data-live class="body">
							if run := session.Run; run != nil {
								if run.EarlierSteps > 0 {
									<p class="faint small">{ run.EarlierSteps } earlier triage agent steps are not shown. Watch the session to see all triage agent steps.</p>
								}
								<ol class="timeline">
									for _, step := range run.Steps {
										<li class="agent"><time>{ frame.Clock(step.OccurredAt) }</time><span class="dot"></span>
											<div><span class="faint small">{ step.Kind }</span><pre>{ step.Text }</pre></div>
										</li>
									}
									if len(run.Steps) == 0 {
										<li><span></span><span></span><div class="faint">No steps yet.</div></li>
									}
								</ol>
							} else {
								<p class="faint">The agent has not started yet.</p>
							}
						</div>
					</details>
				}
				<details class="more">
					<summary>Notifications sent</summary>
					<div id="incident-deliveries" data-live class="body">
						for _, delivery := range page.Deliveries {
							<p class="small"><span class="faint num">{ frame.Clock(delivery.At) }</span> · { delivery.What } · <a href={ "/deliveries/" + delivery.ID }>{ delivery.Outcome }</a>@colonAndText(delivery.Reason)</p>
						}
						if len(page.Deliveries) == 0 {
							<p class="faint">No notifications for this incident yet.</p>
						}
					</div>
				</details>
				<details class="more">
					<summary>Identifiers</summary>
					<div class="body">
						<dl class="kv">
							<dt>Incident ID</dt>
							<dd><code>{ page.Incident.ID }</code></dd>
							<dt>Alert source ID</dt>
							<dd><code>{ page.Incident.SourceID }</code></dd>
							if page.Incident.SenderIncidentKey != "" {
								<dt>Sender incident key</dt>
								<dd><code>@withBreaksAfterSeparators(page.Incident.SenderIncidentKey)</code></dd>
							}
							<dt>Opening alert ID</dt>
							<dd><a href={ "/alerts/" + page.Incident.OpeningAlertID }><code>{ page.Incident.OpeningAlertID }</code></a></dd>
						</dl>
					</div>
				</details>
			</div>
		</div>
		<div class="col-side">
			<section id="incident-people" data-live class="panel">
				<div class="panel-head">
					<h2>People</h2>
					<a class="small" href="/on-call">On call</a>
				</div>
				<div class="panel-body">
					<dl class="kv">
						<dt>On call</dt>
						<dd>{ page.People.OnCall }</dd>
						if page.People.Backup != "" {
							<dt>Backup</dt>
							<dd>{ page.People.Backup }</dd>
						}
						<dt>Woken so far</dt>
						<dd>{ page.People.Woken }</dd>
						if page.People.Next != "" {
							<dt>At { frame.Clock(page.People.NextAt) }</dt>
							<dd>{ page.People.Next }</dd>
						}
						if page.People.Skipped != "" {
							<dt>Can't be woken</dt>
							<dd>{ page.People.Skipped }</dd>
						}
					</dl>
				</div>
			</section>
			<section class="panel">
				<div class="panel-head"><h2>Where the alert came from</h2></div>
				<div class="panel-body">
					<dl class="kv">
						<dt>Sent by</dt>
						<dd>{ capitalize(page.SentBy) }</dd>
						if page.Incident.SenderIncidentKey != "" {
							<dt>Sender incident key</dt>
							<dd><code>@withBreaksAfterSeparators(page.Incident.SenderIncidentKey)</code></dd>
						}
						<dt>The alert</dt>
						<dd><a href={ "/alerts/" + page.Incident.OpeningAlertID }>Open the alert</a></dd>
						if page.LaterAlerts != 0 {
							<dt>Later alerts</dt>
							<dd>{ page.LaterAlerts }, in “What happened”</dd>
						}
					</dl>
				</div>
			</section>
			if page.StatusPageCanPost {
				<section id="status-page" class="panel">
					<div class="panel-head">
						<h2>Status page</h2>
						<a class="small" href="/status-page">Read the status page</a>
					</div>
					<div class="panel-body">
						if page.StatusPageNoticeID != 0 {
							<p>Notice { page.StatusPageNoticeID }, posted from this incident, is open on the status page.</p>
							<a class="btn block" href="/status-page">Update or resolve notice { page.StatusPageNoticeID }</a>
						} else {
							<p class="small muted">Your customers see only what someone posts. Posting publishes an outage notice titled “{ StatusPageGenericTitle }” that says “{ StatusPageGenericMessage }”. You can add your own words next, or post a different notice on the Status page.</p>
							<form method="post" action="/status-page/notices">
								<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="incident_id" value={ page.Incident.ID }/><button class="btn block">Post to the status page</button>
							</form>
						}
					</div>
				</section>
			}
		</div>
	</div>
}

// escalateOptionText is a member's line in "Escalate to someone else".
func escalateOptionText(frame pageFrame, option escalateOption, readerID string) string {
	text := option.Name
	if option.ID == readerID {
		text += " (you)"
	}
	if !option.UnavailableUntil.IsZero() {
		text += ", unavailable until " + frame.Clock(option.UnavailableUntil)
	}
	return text
}

// incidentCountdownBox is what MMHotline does next by itself, in the decide
// box, with a bar for the step's time; nothing for a nil countdown.
templ incidentCountdownBox(countdown *incidentCountdown) {
	if countdown != nil {
		<div class="countdown">
			<div class="row spread">
				if countdown.TimeLeft != "" {
					<span>{ countdown.Sentence }</span><span class="faint num">{ countdown.TimeLeft }</span>
				} else {
					<span>{ countdown.Sentence }</span>
				}
			</div>
			if countdown.StepSeconds != 0 {
				<progress class="bar" value={ strconv.FormatInt(countdown.ElapsedSeconds, 10) } max={ strconv.FormatInt(countdown.StepSeconds, 10) }>{ countdown.TimeLeft }</progress>
			}
		</div>
	}
}

// incidentEventReached, incidentEventAgain, incidentEventNote, and
// incidentEventAlert are the parts of a "What happened" line after its text.
// Each part that shows begins with the space or line break that separates it
// from the text; written one after the other, they add nothing when empty.
templ incidentEventReached(reached string) {
	if reached != "" {
		{ " " }<span class="faint small">{ reached }.</span>
	}
}

templ incidentEventAgain(frame pageFrame, event incidentEvent) {
	if event.Again != 0 {
		{ " " }<span class="faint small">
			if event.Again == 1 {
				Once more, at { frame.Clock(event.LastAgain) }.
			} else {
				Again { event.Again } times, the last at { frame.Clock(event.LastAgain) }.
			}
		</span>
	}
}

templ incidentEventNote(note string) {
	if note != "" {
		<br/><span class="muted">{ note }</span>
	}
}

templ incidentEventAlert(event incidentEvent) {
	if event.AlertID != "" {
		{ " " }<a class="small" href={ "/alerts/" + event.AlertID }>
			if event.AlertLabel != "" {
				{ event.AlertLabel }
			} else {
				The alert
			}
		</a>
	}
}

// incidentTriageAgentPanel is what the triage agent found and does about the
// incident, with Take over, which takes its triage session over from it
// (triage_session_take_over.go) and returns here. It needs page.TriageSession.
templ incidentTriageAgentPanel(frame pageFrame, page incidentPage) {
	<section id="triage-agent" data-live class="panel">
		<div class="panel-head">
			<h2>
				if page.TriageReport != nil {
					What the triage agent found
				} else {
					The triage agent
				}
			</h2>
			if page.TriageSession.Phase == "working" {
				<span class="tag work">Working since { frame.Clock(page.TriageSession.Started) }</span>
			} else if page.TriageSession.Phase == "waiting" {
				<span class="tag">Waiting</span>
			} else if page.TriageSession.Phase == "ended" {
				<span class="tag">Ended</span>
			} else if page.TriageSession.Phase == "stopping" {
				<span class="tag work">Stopping</span>
			} else {
				<span class="tag work">Handing over</span>
			}
		</div>
		<div class="panel-body">
			if report := page.TriageReport; report != nil {
				<p class="finding">{ report.Summary }</p>
				<p class="faint small">The triage agent's report at { frame.Clock(report.At) } contains findings MMHotline has not checked.</p>
				<details class="more">
					<summary>The whole report</summary>
					<div class="body"><pre>{ report.Text }</pre></div>
				</details>
			}
			<p class="muted">
				if page.TriageSession.Phase == "ended" {
					The triage session ended at { frame.Clock(page.TriageSession.Ended) }: { page.TriageSession.EndedBecause }
				} else if page.TriageSession.Phase == "working" {
					The triage agent is looking into the incident now. See “The triage agent's steps” below.
				} else {
					{ page.TriageSession.PhaseText }
				}
			</p>
			if page.TriageSession.Stoppable() {
				<p class="faint small">
					if page.HeldForTriageAgent {
						When you take over, the triage agent finishes the current step, reports the findings, and runs nothing more. MMHotline then wakes the person on call at once.
					} else {
						When you take over, the triage agent finishes the current step, reports the findings, and runs nothing more.
					}
				</p>
			}
		</div>
		<div class="panel-foot"><a href={ "/triage-sessions/" + page.TriageSession.SessionID }>Watch the session</a>@incidentTakeOverForm(page)</div>
	</section>
}

// incidentTakeOverForm is Take over from the agent, while the session can
// still be stopped.
templ incidentTakeOverForm(page incidentPage) {
	if page.TriageSession.Stoppable() {
		<form method="post" action={ "/triage-sessions/" + page.TriageSession.SessionID + "/stop" }>
			<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="return_to_incident_id" value={ page.ReturnToIncidentID }/><button class="btn small">Take over from the agent</button>
		</form>
	}
}

// incidentApprovalsPanel shows, in short, each approval request and warned
// run of the incident's triage session, with Approve and run (or Stop) and
// a link to the approval's own page, which lists each task.
templ incidentApprovalsPanel(frame pageFrame, page incidentPage) {
	<div
		id="incident-approvals"
		data-live
		class="stack"
		if len(page.OpenApprovals) == 0 && len(page.Decided) == 0 {
			hidden
		}
	>
		for _, approval := range page.OpenApprovals {
			<section class="decide warn approval" id={ "approval-" + approval.ID }>
				<div class="panel-head">
					<h2>
						if approval.Warned {
							A playbook runs at { frame.Clock(approval.RunsAt) } unless someone stops it
						} else {
							Approval needed to run a playbook
						}
					</h2>
					<span class="tag warn">
						if approval.Warned {
							Runs { frame.RelativeTime(approval.RunsAt) }
						} else {
							Needs { countText(approval.ApprovalsNeeded, "person", "people") }
						}
					</span>
				</div>
				<div class="panel-body">
					<p><strong>{ approval.Question() }</strong></p>
					<p class="faint">{ approval.Where() }</p>
					if len(approval.Kinds) > 0 {
						<ul class="plain">
							for _, kind := range approval.Kinds {
								<li>{ kind }</li>
							}
						</ul>
					}
					<p class="faint small">{ approval.Why }</p>
					if approval.Warned {
						<form method="post" action={ "/approvals/" + approval.ID + "/stop" }>
							<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="return_to_incident_id" value={ page.ReturnToIncidentID }/><label class="field">Reason for stopping (optional)<input name="reason" maxlength={ strconv.Itoa(page.MaximumReasonCharacters) }/></label>
							<div class="row"><button class="btn primary">Stop</button><a class="btn" href={ "/approvals/" + approval.ID }>Review first</a></div>
						</form>
					} else if approval.ApprovedByYou {
						<p>You approved the playbook run. The playbook run needs approval from another person.</p>
						<div class="row"><a class="btn" href={ "/approvals/" + approval.ID }>Review the playbook run</a></div>
					} else {
						<div class="row">
							<form method="post" action={ "/approvals/" + approval.ID + "/approve" }>
								<input type="hidden" name="csrf" value={ page.CSRF }/><input type="hidden" name="return_to_incident_id" value={ page.ReturnToIncidentID }/><button class="btn primary">{ approval.ApproveLabel }</button>
							</form>
							<a class="btn" href={ "/approvals/" + approval.ID }>Review first</a>
						</div>
					}
				</div>
			</section>
		}
		if len(page.Decided) > 0 {
			<section class="panel">
				<div class="panel-head"><h2>Playbook runs</h2></div>
				<div class="panel-body">
					for _, approval := range page.Decided {
						<p id={ "approval-" + approval.ID } class="small"><a href={ "/approvals/" + approval.ID }>{ approval.Question() }</a> { approval.StateLabel }, { frame.Clock(approval.Changed) }.</p>
					}
				</div>
			</section>
		}
	</div>
}
