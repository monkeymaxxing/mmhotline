package app

import "strconv"

// downAlarmPanel is the dashboard's MMHotline-down alarm panel: whether
// MMHotline checks in, whom the alarm wakes if MMHotline goes quiet, what it
// sent, and a test. The dashboard passes its DownAlarm, its CSRF token, and
// the settings file's notice.
templ downAlarmPanel(frame pageFrame, alarm DownAlarmView, csrf string, notice settingsFileNoticeView) {
	<section id="mmhotline-down-alarm" data-live class="panel" aria-labelledby="mmhotline-down-alarm-heading">
		<div class="panel-head">
			<h2 id="mmhotline-down-alarm-heading">MMHotline-down alarm</h2>
			if alarm.CheckInsFailingSince != nil {
				<span class="tag warn">Not checking in</span>
			} else if alarm.LastCheckInAcceptedAt != nil {
				<span class="tag ok">Checking in</span>
			} else {
				<span class="tag">Starting</span>
			}
		</div>
		<div class="panel-body">
			if failingSince := alarm.CheckInsFailingSince; failingSince != nil {
				<p class="line-warn small">MMHotline has failed to check in with the MMHotline-down alarm since { frame.Clock(*failingSince) }. Without check-ins, the MMHotline-down alarm acts as if MMHotline were down: it sends its urgent alerts once, then nothing more, even if MMHotline really goes down later.</p>
				<details class="fold">
					<summary>Why</summary>
					<p class="small">{ alarm.LastCheckInError }</p>
				</details>
			} else if acceptedAt := alarm.LastCheckInAcceptedAt; acceptedAt != nil {
				<p>MMHotline last checked in { frame.RelativeTime(*acceptedAt) }.</p>
			} else {
				<p>MMHotline has not checked in with the MMHotline-down alarm since MMHotline started.</p>
			}
			if len(alarm.HeldMessages) > 0 {
				<p class="faint small">If MMHotline goes quiet, the MMHotline-down alarm wakes:</p>
				<ul class="bullets faint small">
					for _, held := range alarm.HeldMessages {
						<li>{ held.ContactMethodType } to { held.PersonName } after { strconv.FormatInt(held.DelayMinutes, 10) } minutes</li>
					}
				</ul>
			} else {
				<p class="line-warn small">If MMHotline goes quiet, the MMHotline-down alarm wakes nobody: nobody on call gets SOS alerts by Pushover or automated voice call.</p>
			}
			if len(alarm.RecentSends) > 0 {
				<p class="faint small">The MMHotline-down alarm sent:</p>
				<ul class="bullets faint small">
					for _, send := range alarm.RecentSends {
						<li>{ send.ContactMethodType } to { send.PersonName }, at { frame.Clock(send.DueAt) }</li>
					}
				</ul>
			}
		</div>
		<div class="panel-foot">
			<p class="line-warn"><strong>THE PHONE MAY SOUND ONCE MORE. THERE IS NOTHING TO DO.</strong></p>
			<form method="post" action="/mmhotline-down-alarm/send-test" class="row"><input type="hidden" name="csrf" value={ csrf }/><button class="btn small">Send a test now</button><span>Each person above gets a test alert now. For a Pushover notification, MMHotline checks Pushover's receipt and cancels the repeats.</span></form>
			<details class="fold">
				<summary>Where the MMHotline-down alarm is set up</summary>
				@settingsFileNoticeLine(notice) {
					<code>mmhotline_down_alarm</code>
				}
			</details>
		</div>
	</section>
}

// downAlarmTestLine is one test alert's result.
type downAlarmTestLine struct{ ContactMethodType, PersonName, Outcome string }

// downAlarmTestErrorBody is the page that says the test could not be sent.
templ downAlarmTestErrorBody(reason string) {
	<section class="panel">
		<div class="panel-body">
			<p class="form-error" role="alert">{ reason }</p>
			<a href="/dashboard">Back to the dashboard</a>
		</div>
	</section>
}

// downAlarmTestResultBody is the page with the test alerts' results.
templ downAlarmTestResultBody(lines []downAlarmTestLine) {
	<section class="panel">
		<div class="panel-body">
			<p>The MMHotline-down alarm returned these results for the test alerts:</p>
			<ul class="bullets">
				for _, line := range lines {
					<li>{ line.ContactMethodType } to { line.PersonName }: { line.Outcome }</li>
				}
				if len(lines) == 0 {
					<li>Nothing: the MMHotline-down alarm has nobody to reach.</li>
				}
			</ul>
			<a href="/dashboard">Back to the dashboard</a>
		</div>
	</section>
}
