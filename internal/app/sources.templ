package app

import "strconv"

// sourcesPageBody is the Alert sources page's body.
templ sourcesPageBody(frame pageFrame, data sourcesPageData) {
	<div class="stack alert-pages">
		<section class="panel">
			<div class="panel-head">
				<h2>Senders</h2>
			</div>
			if len(data.Sources) > 0 {
				<ul class="items">
					for _, source := range data.Sources {
						<li>
							<div class="what">
								<div class="row">
									<a class="title" href={ "/alert-sources/" + source.ID }>{ source.Name }</a><span class={ "tag " + source.Tone }>{ source.Status }</span>
								</div>
								if source.Active {
									<p class="small muted">
										if source.Kind == "generic" {
											Generic signed JSON
										} else {
											{ source.Kind }
										}
									</p>
								} else {
									<p class="small muted">The settings file no longer lists this source, so the source's signing secrets no longer work. Earlier alerts and check-ins stay.</p>
								}
								if source.RejectedTotal > 0 {
									<p class={ sourceRejectedClass(source.RejectedTotal) }>Rejected requests in the last 24 hours: { strconv.FormatInt(source.RejectedTotal, 10) }</p>
									if len(source.RejectedReasons) > 0 {
										<ul class="bullets small">
											for _, rejected := range source.RejectedReasons {
												<li>{ rejected.Reason }: { strconv.FormatInt(rejected.Count, 10) }</li>
											}
										</ul>
									}
								}
								<details class="fold">
									<summary>Connection details</summary>
									<div class="source-connection">
										<dl class="kv">
											<dt>Alert intake address</dt>
											<dd><code>{ data.AlertIntakeAddress }</code></dd>
											<dt>Alert source ID</dt>
											<dd><code>{ source.ID }</code></dd>
											<dt>Intake URL</dt>
											<dd><code>{ "POST " + data.AlertIntakeAddress + "/alert-intake/" + source.ID }</code></dd>
											<dt>Check-in URL</dt>
											<dd><code>{ "POST " + data.AlertIntakeAddress + "/check-in/" + source.ID }</code></dd>
										</dl>
										if source.Active && data.Admin {
											<p class="small faint">Signing secret IDs identify the configured secrets. Secret values are never shown.</p>
											<ul class="bullets small">
												for _, secret := range source.Secrets {
													<li>Signing secret ID: <code>{ secret.ID }</code>, added { frame.Clock(secret.CreatedAt) }</li>
												}
											</ul>
										}
									</div>
								</details>
							</div>
						</li>
					}
				</ul>
			} else {
				<div class="panel-body">
					<p>No alert sources are set up.</p>
					<p class="small muted">An administrator adds the sending tool or script under <code>alert_sources</code> in the settings file. Open “Where alert sources are set” for the file and apply command.</p>
				</div>
			}
		</section>
		<details class="more">
			<summary>Where alert sources are set</summary>
			<div class="body">
				@settingsFileNoticeLine(data.settingsFileNoticeView) {
					<code>alert_sources</code>
				}
			</div>
		</details>
		<details class="more">
			<summary>Request format and signing</summary>
			<div class="body">
				<p class="small muted">Send signed JSON to the source's Intake URL. The sender uses the signing secret from the team's vault.</p>
				<pre>{ `{"sender_alert_id":"alert-1","sender_incident_key":"backup","severity":"sos","title":"Backup failed","message":"Disk full"}` }</pre>
				<p class="small"><code>Mmhotline-Signature: timestamp_unix_seconds=&lt;unix seconds&gt;,hmac_sha256_hex=&lt;hex HMAC-SHA256&gt;</code>. Decode the 64 hexadecimal characters of the signing secret into 32 bytes, and compute HMAC-SHA256 over the timestamp, a dot, and the exact JSON bytes. The timestamp must be within five minutes. Reuse a sender alert ID when retrying.</p>
				<p class="small">An SOS is the urgent alert that wakes the person on call, even at night. A <code>resolved-sos</code> alert with the same sender incident key closes the matching unresolved SOS incident.</p>
				<p class="small">A sender that checks in posts a signed message every 30 seconds to the Check-in URL. MMHotline starts watching for missing check-ins after the first check-in arrives.</p>
			</div>
		</details>
	</div>
}
